# =====================================================================
# Piyade RP — BEYİN Botu Ortam Değişkenleri (.env.example)
# =====================================================================
# Altın kural: Beyin diğer botların token'larını ASLA bilmez ve okumaz.
# Buraya yalnızca Beyin'in kendi anahtarları girilir.

# ── 1. Discord Ayarları (Zorunlu) ──
BRAIN_TOKEN=YOUR_BRAIN_DISCORD_BOT_TOKEN
OWNER_ID=YOUR_DISCORD_USER_ID
GUILD_ID=1529545898294509589

# Denetim kaydı (Audit Log) kontrollerinde muaf tutulacak ek güvenilir yönetici ID'leri (virgülle ayrılmış)
TRUSTED_USER_IDS=

# Güvenlik botunun (piyader.rp.security.bot) bildirim attığı log kanalı ID'si
SECURITY_LOG_CHANNEL_ID=

# ── 2. Railway Salt-Okuma API (Önerilen) ──
# Railway Project Settings -> Tokens bölümünden oluşturulan Project Token
RAILWAY_API_TOKEN=
RAILWAY_TOKEN_TYPE=project
# Railway içindeyken otomatik algılanır; farklı projedeyse elle girilebilir:
BRAIN_RAILWAY_PROJECT_ID=
BRAIN_RAILWAY_ENVIRONMENT_ID=
RAILWAY_POLL_SECONDS=30
RAILWAY_LOG_LIMIT=150

# ── 3. GitHub Salt-Okuma (İsteğe Bağlı — Public repolarda tokensız da çalışır) ──
# Fine-grained PAT (Yalnızca Contents: Read ve Metadata: Read)
GITHUB_TOKEN=
GITHUB_BRANCH=main

# ── 4. Yapay Zeka Kök Neden Analizi (Önerilen) ──
# Varsayılan model gemini-2.5-flash'tır (404 durumunda gemini-2.0-flash otomatik denenir)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_MAX_CALLS_PER_HOUR=20

# ── 5. Veritabanı ve Redis Bayrak Deposu (Railway'de kalıcı hafıza için PostgreSQL önerilir) ──
DATABASE_URL=
REDIS_URL=
PORT=8080

# ── 6. Nabız Ajanı Anahtarları (`agent/brain_agent.py` kullanılacaksa) ──
# Tüm `/agent/*` uç noktaları `X-Brain-Key` başlığıyla korunur (en az 16 karakter).
# Bot bazlı anahtarlar VEYA tek ortak gizli anahtar (`BRAIN_SHARED_SECRET`) tanımlanabilir:
AGENT_KEYS=ana-bot:degistir_uzun_gizli_anahtar_1,ticket-bot:degistir_uzun_gizli_anahtar_2
BRAIN_SHARED_SECRET=

# ── 7. Bildirim, Otomatik Eylem ve Harici Nabız ──
# Sessiz saatler (TSİ, örn: 02:00-09:00). Kritik (🔴) alarmlar sessiz saatleri deler.
QUIET_HOURS=
DAILY_REPORT_HOUR=9
MAX_DM_PER_MINUTE=8

# Varsayılan: AUTO_ACTIONS=false ("Sadece Öner" modu — hiçbir modülü kendi kendine kapatmaz).
AUTO_ACTIONS=false
MAX_AUTO_ACTIONS_PER_HOUR=5

# İsteğe bağlı Cloudflare güvenlik duvarı entegrasyonu (IP engelleme için)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# UptimeRobot / Better Stack Push URL (Beyin'in kendi nabzını dışarıya göndermesi için)
UPTIME_PUSH_URL=
